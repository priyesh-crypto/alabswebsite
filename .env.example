# --------------------------------------------------------------------
# Database (Postgres) — Option C from ASSUMPTIONS.md §1
# --------------------------------------------------------------------
# Local Docker example:
#   docker run -d --name alabs-pg -e POSTGRES_PASSWORD=alabs \
#     -e POSTGRES_USER=alabs -e POSTGRES_DB=alabs -p 5432:5432 postgres:16
DATABASE_URL=postgresql://alabs:alabs@localhost:5432/alabs?schema=public

# --------------------------------------------------------------------
# Auth — hand-rolled JWT in httpOnly cookies (no NextAuth)
# --------------------------------------------------------------------
# 32+ characters. Generate: `openssl rand -base64 48`
JWT_SECRET=replace-with-a-32-plus-character-random-string

# --------------------------------------------------------------------
# Uploads
# --------------------------------------------------------------------
UPLOAD_DRIVER=local            # 'local' | 's3'
UPLOAD_DIR=./public/uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=

# --------------------------------------------------------------------
# Misc
# --------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
