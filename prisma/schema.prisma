// AnalytixLabs Prisma schema
// Source of record: CLAUDE.md §6 + PLAN.md §9 (new model `Office`,
// new fields on Course / SiteSettings / Lead / Faq).
// Stack: Postgres + Prisma 6 (Option C from ASSUMPTIONS.md §1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Auth
// ============================================================

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  EDITOR
}

// ============================================================
// Site-wide settings (singleton row id=1)
// ============================================================

model SiteSettings {
  id              Int      @id @default(1)
  logoUrl         String
  faviconUrl      String?
  primaryColor    String   @default("#09263f")
  contactEmail    String
  contactPhone    String
  businessHours   String   @default("10:00 AM TO 07:00 PM")
  address         String
  socialLinks     Json
  stats           Json
  gtmId           String?
  defaultMetaDesc String?
  ogImageUrl      String?
  updatedAt       DateTime @updatedAt
}

// ============================================================
// Navigation
// ============================================================

model NavItem {
  id       String    @id @default(cuid())
  label    String
  url      String
  order    Int
  parentId String?
  parent   NavItem?  @relation("NavTree", fields: [parentId], references: [id])
  children NavItem[] @relation("NavTree")
  group    NavGroup
  isActive Boolean   @default(true)
}

enum NavGroup {
  TOP_NAV
  MEGA_MENU
  FOOTER_LINKS
  FOOTER_CITIES
  FOOTER_COL_ABOUT
  FOOTER_COL_ETC
  FOOTER_COL_POPULAR
}

// ============================================================
// Catalog
// ============================================================

model Category {
  id      String   @id @default(cuid())
  name    String
  slug    String   @unique
  order   Int
  // Hex pill background used by the landing-page marquee. Optional — if null
  // the component falls back to a per-index palette.
  color   String?
  courses Course[]
}

model Course {
  id                String          @id @default(cuid())
  slug              String          @unique
  title             String
  shortDesc         String
  longDesc          String
  thumbnailUrl      String
  heroImageUrl      String?
  durationMonths    Int?
  classesCount      Int?
  hoursCount        Int?
  experienceLabel   String?
  price             Int?
  discountedPrice   Int?
  emiPerMonth       Int?
  brochureUrl       String?
  isFeatured        Boolean         @default(false)
  isPublished       Boolean         @default(true)
  order             Int             @default(0)
  jobRoles          String[]        @default([])
  keySkills         String[]        @default([])
  careerSupportText String?
  metaTitle         String?
  metaDesc          String?
  // Phase 1 additions (admin panel section-based editing)
  rating            Decimal?        @db.Decimal(3, 1)
  alumniCount       Int?
  heroImage         String?
  heroBadges        Json?           // string[]
  heroCtaPrimary    Json?           // { label, href }
  heroCtaSecondary  Json?           // { label, href }
  whoShouldJoin     Json?           // { audience, description }[]
  hasNoCodingRequired Boolean       @default(false)
  // ============================================================
  // New PDP (Course Detail Page) extension fields — all optional.
  // ============================================================
  pdpAlumniText           String?
  pdpStarsTotal           Int?
  pdpRatingScale          Float?
  pdpTaxNote              String?
  pdpEmiNote              String?
  pdpCities               String[] @default([])
  pdpStatTiles            Json?
  pdpOverviewHighlights   Json?
  pdpCurriculumHeading    String?
  pdpCurriculumSubheading String?
  pdpCurriculumSummary    Json?
  pdpTestimonialStrip     Json?
  pdpProjectDomains       Json?
  pdpCareerSupport        Json?
  pdpHowToApply           Json?
  pdpStudentStories       Json?
  pdpRelatedArticles      Json?
  pdpCtaBanner            Json?
  pdpContactBlock         Json?
  pdpFaqsData             Json?
  pdpLearningModesData    Json?
  pdpCertificationData    Json?
  pdpWhoShouldJoinData    Json?
  pdpJobRolesData         Json?
  pdpKeySkillsData        Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  modules           CourseModule[]
  batches           Batch[]
  faqs              Faq[]
  tools             Tool[]          @relation("CourseTools")
  certifications    Certification[]
  projects          Project[]
  pricing           CoursePricing[]
}

model CourseModule {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  summary  String?
  order    Int
  lessons  Lesson[]
}

model Lesson {
  id       String       @id @default(cuid())
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title    String
  duration String?
  order    Int
}

model Tool {
  id      String   @id @default(cuid())
  name    String
  iconUrl String?
  courses Course[] @relation("CourseTools")
}

model Certification {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  issuer   String
  imageUrl String?
}

model Project {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  desc     String
  imageUrl String?
}

model Batch {
  id        String        @id @default(cuid())
  courseId  String
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  location  String
  startDate DateTime
  schedule  String
  seatsLeft Int
  isActive  Boolean       @default(true)
  // Optional FK linking a batch to a LearningMode (Weekday Bootcamp, Weekday
  // Batches, Self-paced Blended, …). When set, the landing-page Learning
  // Modes section filters its right-side cards by this field.
  modeId    String?
  mode      LearningMode? @relation(fields: [modeId], references: [id])
}

// ============================================================
// Learning modes (NEW — landing-page Phase A)
// ============================================================

model LearningMode {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  subtitle String?
  order    Int     @default(0)
  isActive Boolean @default(true)
  batches  Batch[]
}

// ============================================================
// Marketing surfaces
// ============================================================

model Testimonial {
  id       String  @id @default(cuid())
  name     String
  role     String?
  company  String?
  photoUrl String?
  quote    String
  rating   Int     @default(5)
  courseId String?
  order    Int     @default(0)
  isActive Boolean @default(true)
}

model HiringPartner {
  id      String @id @default(cuid())
  name    String
  logoUrl String
  order   Int    @default(0)
}

model TeamMember {
  id          String  @id @default(cuid())
  name        String
  role        String
  photoUrl    String?
  bio         String?
  linkedinUrl String?
  order       Int     @default(0)
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  scope    String // "GLOBAL" | "ABOUT" | "CONTACT" | <courseId>
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])
  order    Int     @default(0)
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  coverUrl    String?
  body        String
  authorName  String
  publishedAt DateTime?
  isPublished Boolean   @default(false)
  tags        String[]  @default([])
  metaTitle   String?
  metaDesc    String?
}

// ============================================================
// Editable copy blocks for non-Figma pages and flexible sections
// ============================================================

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  blocks    Json
  metaTitle String?
  metaDesc  String?
  updatedAt DateTime @updatedAt
}

// ============================================================
// Offices (NEW — PLAN.md §9.1)
// ============================================================

model Office {
  id            String  @id @default(cuid())
  city          String
  addressLine1  String
  addressLine2  String?
  phone         String
  hours         String
  directionsUrl String
  mapImageUrl   String?
  // Google Maps embed iframe `src`. Validated server-side to start with
  // `https://www.google.com/maps`. Optional — the public site falls back to
  // `?q=AnalytixLabs+<city>&output=embed` when null.
  mapEmbedUrl   String?
  order         Int     @default(0)
  isActive      Boolean @default(true)
}

// ============================================================
// Leads (extended — PLAN.md §9.2)
// ============================================================

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  countryCode String?
  phone       String?
  message     String?
  city        String?
  company     String?
  teamSize    String?
  courseId    String?
  source      String
  utm         Json?
  createdAt   DateTime @default(now())
}

// ============================================================
// Masterclass + Uploads
// ============================================================

model Masterclass {
  id          String    @id @default(cuid())
  title       String
  bannerUrl   String
  registerUrl String
  startsAt    DateTime?
  isActive    Boolean   @default(true)
}

model UploadedAsset {
  id        String   @id @default(cuid())
  url       String
  mimeType  String
  size      Int
  alt       String?
  createdAt DateTime @default(now())
}

// ============================================================
// Section-based page editing (Phase 1 admin panel)
// ============================================================

// One row per visible section on a page. `type` maps to a registered
// section definition in lib/sections/index.ts. Content is stored as JSON
// blobs (draft + published) so non-destructive editing is trivial.
model Section {
  id               String   @id @default(cuid())
  pageSlug         String   // "landing" | "courses" | "course/<courseSlug>"
  type             String   // e.g. "hero_landing", "testimonials_carousel"
  label            String   // human-readable name for admin accordion header
  order            Int
  isVisible        Boolean  @default(true)
  contentDraft     Json
  contentPublished Json?
  updatedAt        DateTime @updatedAt
  updatedById      String?

  @@index([pageSlug, order])
}

// Singleton records for global blocks (header, footer, cta-banner, call-back).
// key is one of: "header" | "footer" | "cta_banner" | "call_back"
model GlobalBlock {
  key         String   @id
  label       String
  data        Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// Immutable audit trail. Written on every section/global-block save + publish.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  userName   String
  entityType String   // "Section" | "GlobalBlock" | "Course" | ...
  entityId   String
  action     String   // "update_draft" | "publish" | "revert" | "create" | "delete"
  diff       Json
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Per-course pricing rows (one per learning mode: classroom / online / elearning).
model CoursePricing {
  id           String  @id @default(cuid())
  courseId     String
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mode         String  // "classroom" | "online" | "elearning"
  label        String  // display label e.g. "Classroom & Bootcamp"
  price        Int     // in paise
  priceStruck  Int?    // struck-through original price
  installments Int     @default(3)
  hasEmi       Boolean @default(true)
  ctaLabel     String  @default("Enroll now")
  ctaHref      String?
  order        Int     @default(0)
}
